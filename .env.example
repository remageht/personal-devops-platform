# ==============================================================================
# Personal DevOps Platform - Environment Configuration Template
# Copy this file to .env and configure values before starting services.
# NEVER commit the real .env file to version control!
# ==============================================================================

# --- Authentication & Security ---
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=replace_with_argon2_or_bcrypt_hash
LEGACY_TOKEN_ALLOW=0
API_TOKEN=replace_with_secure_random_api_token

# --- Monitoring (Grafana) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace_with_secure_grafana_password

# --- Networking & CORS ---
CORS_ORIGINS=
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Automation & Script Execution ---
ALLOWED_SCRIPTS=system-info.sh,clean-docker.sh,update-system.sh
SCRIPT_TIMEOUT=30
MAX_OUTPUT_CHARS=50000
RATE_LIMIT_PER_MIN=60
ALLOW_PRUNE=0
ALLOW_SELF_STOP=0

# --- Logging ---
LOG_LEVEL=INFO
