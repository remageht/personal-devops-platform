# Скопируйте в .env и заполните. .env НЕ коммитить!
API_TOKEN=change-me-to-long-random-string
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
CORS_ORIGINS=
ALLOWED_SCRIPTS=system-info.sh,clean-docker.sh,update-system.sh
SCRIPT_TIMEOUT=30
MAX_OUTPUT_CHARS=50000
RATE_LIMIT_PER_MIN=60
ALLOW_PRUNE=0
ALLOW_SELF_STOP=0
LOG_LEVEL=INFO
